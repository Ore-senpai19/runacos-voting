# --- Database (Supabase Postgres) ---
# Project Settings -> Database -> Connection string, in your Supabase dashboard.
# DATABASE_URL: the pooled "Transaction" connection (port 6543) — used at runtime.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: the direct connection (port 5432) — used only by `prisma db push` / migrations.
DIRECT_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Random 32+ char secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

# --- School email restriction ---
SCHOOL_EMAIL_DOMAIN="run.edu.ng"

# --- Seed admin account (used by prisma/seed.ts) ---
SEED_ADMIN_EMAIL="admin@run.edu.ng"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- OTP emails ---
# Sending is handled entirely by a Supabase Postgres trigger, not this app —
# see supabase/otp-email-trigger.sql for the one-time setup. There is
# nothing to configure here; this app only ever writes the OTP code to the
# database, it never sends email itself.

# --- Candidate photo storage (Supabase Storage) ---
# Project Settings -> API, in your Supabase dashboard.
# SUPABASE_URL: your project's "Project URL".
SUPABASE_URL="https://xxxxxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY: the "service_role" secret key (NOT the "anon" key).
# This has full access to your project — keep it server-side only, never
# expose it to the browser, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
# Name of the public Storage bucket you create for candidate photos. Create
# it once in Supabase: Storage -> New bucket -> name it exactly this ->
# toggle "Public bucket" ON -> Create. Defaults to "candidate-photos" if unset.
SUPABASE_STORAGE_BUCKET="candidate-photos"
